<Window x:Class="StudyNest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StudyNest" Height="820" Width="1280" MinHeight="560" MinWidth="900"
        Background="{StaticResource Mist}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: notebooks and pages -->
        <Border Background="{StaticResource Navy}">
            <DockPanel Margin="18,20,18,18">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="StudyNest" Foreground="{StaticResource Cream}"
                               FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="NOTEBOOK" Foreground="#9FB7C6" FontSize="11" FontWeight="SemiBold"
                               Margin="0,20,0,6"/>
                    <ComboBox x:Name="NotebookBox" DisplayMemberPath="Name" FontSize="14"
                              SelectionChanged="NotebookBox_SelectionChanged"/>
                    <Button Content="Rename notebook" Style="{StaticResource SidebarButton}"
                            Margin="0,8,0,0" Click="RenameNotebook_Click"/>
                    <TextBlock Text="PAGES" Foreground="#9FB7C6" FontSize="11" FontWeight="SemiBold"
                               Margin="0,16,0,6"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="+  New page" Style="{StaticResource SidebarButton}" Click="NewPage_Click"/>
                    <Button Content="+  New notebook" Style="{StaticResource SidebarButton}" Click="NewNotebook_Click"/>
                    <Button Content="Delete page" Style="{StaticResource SidebarButton}" Click="DeletePage_Click"/>
                </StackPanel>

                <ListBox x:Name="PageList" DisplayMemberPath="Title"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SidebarItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="PageList_SelectionChanged"/>
            </DockPanel>
        </Border>

        <!-- Workspace -->
        <DockPanel Grid.Column="1">

            <!-- Toolbar -->
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Hairline}"
                    BorderThickness="0,0,0,1" Padding="14,8">
                <DockPanel>
                    <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center"
                               Foreground="#5C7686" FontSize="12" Margin="12,0,0,0"/>
                    <WrapPanel VerticalAlignment="Center">
                        <RadioButton x:Name="TypeTool" Content="Type" GroupName="tool"
                                     Style="{StaticResource ToolButton}" Checked="Tool_Checked"
                                     ToolTip="Type text (Ctrl+1)"/>
                        <RadioButton x:Name="PenTool" Content="Pen" GroupName="tool"
                                     Style="{StaticResource ToolButton}" Checked="Tool_Checked"
                                     ToolTip="Draw and write by hand (Ctrl+2)"/>
                        <RadioButton x:Name="HighlighterTool" Content="Highlighter" GroupName="tool"
                                     Style="{StaticResource ToolButton}" Checked="Tool_Checked"
                                     ToolTip="Highlight over anything on the page (Ctrl+3)"/>
                        <RadioButton x:Name="EraserTool" Content="Eraser" GroupName="tool"
                                     Style="{StaticResource ToolButton}" Checked="Tool_Checked"
                                     ToolTip="Erase whole strokes (Ctrl+4)"/>

                        <Border Width="1" Height="22" Background="{StaticResource Hairline}" Margin="8,0,12,0"/>

                        <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" VerticalAlignment="Center"/>

                        <Slider x:Name="SizeSlider" Minimum="1" Maximum="24" Value="4" Width="100"
                                Margin="8,0,0,0" VerticalAlignment="Center"
                                ValueChanged="Size_Changed" ToolTip="Stroke size"/>

                        <Border Width="1" Height="22" Background="{StaticResource Hairline}" Margin="12,0,12,0"/>

                        <Button Content="B" FontWeight="Bold" Style="{StaticResource FlatButton}"
                                Command="EditingCommands.ToggleBold"
                                CommandTarget="{Binding ElementName=Editor}" ToolTip="Bold"/>
                        <Button Content="I" FontStyle="Italic" Style="{StaticResource FlatButton}"
                                Command="EditingCommands.ToggleItalic"
                                CommandTarget="{Binding ElementName=Editor}" ToolTip="Italic"/>
                        <Button Content="U" Style="{StaticResource FlatButton}"
                                Command="EditingCommands.ToggleUnderline"
                                CommandTarget="{Binding ElementName=Editor}" ToolTip="Underline"/>
                        <Button Content="• List" Style="{StaticResource FlatButton}"
                                Command="EditingCommands.ToggleBullets"
                                CommandTarget="{Binding ElementName=Editor}" ToolTip="Bulleted list"/>
                        <Button Content="Highlight" Style="{StaticResource FlatButton}"
                                Click="HighlightText_Click" ToolTip="Highlight the selected text"/>

                        <Border Width="1" Height="22" Background="{StaticResource Hairline}" Margin="8,0,12,0"/>

                        <Button Content="Undo ink" Style="{StaticResource FlatButton}" Click="UndoInk_Click"
                                ToolTip="Undo last stroke"/>
                        <Button Content="Redo ink" Style="{StaticResource FlatButton}" Click="RedoInk_Click"
                                ToolTip="Redo stroke"/>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- Paper -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border x:Name="Paper" Width="820" MinHeight="1120" Margin="28"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Background="#FFFDF6" CornerRadius="6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#0A2D4A"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="TitleBox" Grid.Row="0" Margin="56,32,32,14"
                                 BorderThickness="0" Background="Transparent"
                                 FontSize="30" FontWeight="Bold" Foreground="{StaticResource Navy}"
                                 TextChanged="TitleBox_TextChanged"/>

                        <Grid Grid.Row="1" Background="{StaticResource LinedPaper}">
                            <!-- Margin rule -->
                            <Border Width="1.5" Background="#55FF7A5C" HorizontalAlignment="Left" Margin="44,0,0,0"/>

                            <RichTextBox x:Name="Editor" Background="Transparent" BorderThickness="0"
                                         FontFamily="Segoe UI" FontSize="17" Foreground="{StaticResource InkText}"
                                         Padding="56,0,32,0" AcceptsTab="True"
                                         VerticalScrollBarVisibility="Disabled"
                                         SpellCheck.IsEnabled="True"
                                         TextChanged="Editor_TextChanged">
                                <RichTextBox.Resources>
                                    <Style TargetType="Paragraph">
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                </RichTextBox.Resources>
                            </RichTextBox>

                            <!-- Ink layer sits on top; it ignores the mouse while the Type tool is active -->
                            <InkCanvas x:Name="Ink" Background="Transparent"
                                       StrokeCollected="Ink_StrokeCollected"
                                       StrokeErased="Ink_StrokeErased"/>
                        </Grid>
                    </Grid>
                </Border>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
